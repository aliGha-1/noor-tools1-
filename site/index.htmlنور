كngs() {
  const nameInput = $("#settingBusinessName");
  const limitInput = $("#settingLowStock");

  const businessName = String(nameInput?.value || "").trim();
  const lowStockLimit = (limitInput?.value);

  if (!businessName) {
    showToast("اكتب اسم المحل");
    return;
  }

  if (
    !Number.isInteger(lowStockLimit) ||
    !Number.isFinite(lowStockLimit) ||
    lowStockLimit < 0
  ) {
    showToast("حد المخزون يجب أن يكون صفرًا أو عددًا صحيحًا موجبًا");
    return;
  }

  const previousSettings = { ...db.settings };

  db.settings = {
    ...db.settings,
    businessName,
    lowStockLimit
  };

  if (!saveDB()) {
    db.settings = previousSettings;
    showToast("تعذر حفظ الإعدادات");
    return;
  }

  showToast("تم حفظ الإعدادات بنجاح");
  render();
}// ===== الجزء السابع: ربط الصفحات وتشغيل التطبيق =====

function render() {
  const view = $("#view");
  if (!view) return;

  switch (currentPage) {
    case "dashboard":
      dashboard();
      break;

    case "products":
      productsPage();
      break;

    case "bulk":
      bulkPage();
      break;

    case "saleNew":
      invoicePage("sale");
      break;

    case "purchaseNew":
      invoicePage("purchase");
      break;

    case "invoices":
      invoicesPage();
      break;

    case "reports":
      reportsPage();
      break;

    case "backup":
      backupPage();
      break;

    case "settings":
      settingsPage();
      break;

    default:
      currentPage = "dashboard";
      dashboard();
      break;
  }

  // إظهار أزرار التنقل حسب العناصر الموجودة في الصفحة.
  const homeButtons = document.querySelectorAll(
    '[onclick="goHome()"]'
  );

  homeButtons.forEach(button => {
    button.style.display = "inline-flex";
  });

  const backButtons = document.querySelectorAll(
    '[onclick="goBack()"]'
  );

  backButtons.forEach(button => {
    button.style.display = "inline-flex";
  });
}

// جعل الدوال متاحة للأزرار الموجودة في HTML.
